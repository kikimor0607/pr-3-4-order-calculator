digraph G {
graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.3, ranksep=0.35];
node [shape=box, style="rounded,filled", fontname="Times New Roman", fontsize=11, color="#2F5597", fillcolor="#EAF2F8", margin="0.12,0.08"];
edge [fontname="Times New Roman", fontsize=9, color="#555555"];
start [label="Начало", shape=oval, fillcolor="#E2F0D9", color="#548235"];
end [label="Завершение", shape=oval, fillcolor="#FCE4D6", color="#C65911"];
n1 [label="Получить количество, цену, скидку (Scanner / строка CSV);\nставка НДС = VAT_RATE = 25 % (вариант 4)", shape=parallelogram, fillcolor="#E4DFEC", color="#7030A0"];
p [label="Значения — числа?\n(Integer.parseInt / Double.parseDouble)", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
n2 [label="A1. validationError: 1 <= quantity <= 10 000;\n0 < unitPrice <= 5 000 000; 0 <= discount <= 30"];
n3 [label="Данные корректны?", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
n4 [label="Вычислить базовую сумму\nbase = unitPrice × quantity (calculateBase)"];
n5 [label="A2. discounted = base × (100 − discount) / 100 (applyDiscount);\nvat = discounted × 25 / 100 (calculateVat); total = discounted + vat"];
n6 [label="Вывести результат с двумя знаками после запятой\n(String.format(\"%.2f\"))"];
n7 [label="Вывести причину ошибки,\nрасчёт не выполнять"];
start -> n1 -> p;
p -> n2 [label="да"];
p -> n7 [label="нет"];
n2 -> n3;
n3 -> n4 [label="да"];
n3 -> n7 [label="нет"];
n4 -> n5 -> n6 -> end;
n7 -> end;
}
